# =============================================================================
# GITIGNORE - PROYECTO WINE QUALITY (IA HÍBRIDA: PRISM + DIFUSA + AG)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. PYTHON Y CACHÉ DE EJECUCIÓN
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# 2. ENTORNOS VIRTUALES (VENV / CONDA)
# -----------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
conda-env/

# -----------------------------------------------------------------------------
# 3. ARCHIVOS TEMPORALES Y AUXILIARES DE LATEX (MiKTeX / TeX Live / Overleaf)
# Ignora toda la basura de compilación intermedia, pero CONSERVA el PDF final.
# -----------------------------------------------------------------------------
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.brf
*.synctex.gz
*.synctex(busy)
*.fdb_latexmk
*.fls
*.nav
*.snm
*.vrb
*.dvi
*.ps
*.spl
*.bcf
*.run.xml
*.glo
*.idx
*.ist
*.upa
*.upb
*.pdfsync

# Conservar expresamente los documentos PDF finales de la documentación
!*.pdf

# -----------------------------------------------------------------------------
# 4. CONFIGURACIONES DE EDITORES / IDEs
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# 5. ARCHIVOS TEMPORALES DEL SISTEMA OPERATIVO
# -----------------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
